<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:jcache="http://www.ehcache.org/v3/jsr107">
    <persistence directory="/tmp/ehcache"/>  <!-- Opcional: armazenamento em disco -->

    <cache alias="default">
        <key-type>java.lang.String</key-type>  <!-- Altere conforme seu uso -->
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>  <!-- Tempo de vida do cache -->
        </expiry>
        <resources>
            <heap unit="MB">10</heap>  <!-- Tamanho em memória -->
        </resources>
    </cache>
</config>
